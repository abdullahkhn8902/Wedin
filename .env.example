# Public origin of the deployed site, used to build the ABSOLUTE share-image
# (Open Graph / Twitter) URL that link-preview crawlers fetch.
#
# - On Vercel you can leave this UNSET: the deployment URL is auto-detected.
# - On any other host (or a custom domain), set this to your live origin so the
#   share image resolves to a public URL instead of localhost.
#
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
